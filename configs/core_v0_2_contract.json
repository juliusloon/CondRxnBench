  "release_layout": {"new_output_directory": "data/processed/core_v0_2", "v0_1_immutable": true, "raw_immutable": true},
  "storage": {
    "authoritative": "parquet", "inspection_mirror": "csv", "arrow_schema_fingerprint_required": true,
    "csv_semantic_tokens": ["NA", "not_reported", "NULL_COMPONENT"],
    "csv_reader_rule": "disable automatic NA conversion; decode explicit *_value_state columns and canonical JSON before analysis",
    "logical_types": {"id": "utf8_non_null", "semantic_token": "utf8_non_null", "flag": "bool_non_null", "numeric_evidence": "float64_nullable", "timestamp": "utc_iso8601", "list_or_map": "arrow_list_or_map__canonical_sorted_json_csv"},
    "equivalence_checks": ["schema_fingerprint", "column_order", "primary_keys_and_order", "row_counts", "booleans", "numeric_values", "arrow_null_and_value_state", "literal_token_counts", "canonical_json", "measurement_semantics"]
  },
  "closed_domains": {
    "component_value_state": ["explicit_component", "explicit_null_component", "not_reported", "NA"],
    "outcome_observation_status": ["observed_numeric", "missing_analysis", "not_detected", "not_reported", "not_assessed"],
    "parse_sanitize_status": ["success", "not_attempted", "not_supported", "failed"],
    "structure_evidence_status": ["source_reported", "evidence_backed_curated", "not_reported", "rejected"],
    "feature_status": ["available", "not_supported", "failed"],
    "review_status": ["accepted", "pending", "rejected", "not_required"],
    "attribute_provenance": ["evidence_backed", "derived"],
    "eligibility_status": ["eligible", "ineligible", "not_assessed"],
    "continuous_value_state": ["observed_numeric", "NA", "not_reported"]
  },
  "sentinel_contract": {
    "NULL_COMPONENT": "literal explicit condition level; never Arrow null, NA, or not_reported",
    "not_reported": "literal source/evidence absence; never registry entity or component reference",
    "NA": "typed missing_or_not_applicable only; Arrow null plus explicit value_state, serialized as literal CSV token NA",
    "observed_zero": "yield_observed=true; zero_yield=true; yield_percent=0; outcome_observation_status=observed_numeric",
    "not_detected": "only direct source evidence; never inferred from numeric zero"
  },
  "structure_standardization_policy": {
    "policy_version": "core_v0_2_proposed_2", "toolkit": {"name": "RDKit", "version": "2024.03.6"},
    "default": "conservative_no_identity_change", "salt_parent_selection": "forbidden_without_source_backed_configured_rule",
    "metal_complex_handling": "retain_raw__normalized_not_supported", "ion_pair_handling": "retain_raw__normalized_not_supported",
    "r_group_marker_handling": "not_supported__no_canonicalization", "canonicalization": "RDKit_canonical_isomeric_smiles_only_after_successful_sanitize",
    "failure_disposition": "retain_raw__record_error_class__no_feature_generation"
