    "pair_baseline": 116156, "eligibility_default": "not_assessed", "provenance_rule": "each record has source_dataset/source_record_id and direct provenance or missing_analysis_export status"
  },
  "validation_negative_cases": ["NULL_COMPONENT_is_not_NA_or_not_reported", "not_reported_is_not_registry_entity", "NA_is_not_component_or_observed_zero", "observed_zero_is_not_null_or_not_detected", "not_detected_requires_direct_evidence", "unaccepted_non_identity_mapping_not_usable", "cross_source_same_spelling_not_equivalent", "missing_structure_no_pseudofingerprint", "raw_numeric_null_never_implies_zero", "perera_unlisted_condition_structure_role_is_default_denied", "record_component_ref_cross_source_or_cross_role_is_rejected", "continuous_value_state_outside_closed_domain_is_rejected", "discrete_condition_state_coverage_below_100_percent_is_rejected", "valid_or_explicit_null_completeness_below_99_percent_is_rejected"]
