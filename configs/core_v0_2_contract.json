    "record_structure_assertions": {"primary_key": ["structure_assertion_id"], "unique": [["reaction_id", "structure_role", "assertion_version"]], "required": ["structure_assertion_id", "reaction_id", "structure_role", "assertion_version", "structure_raw_value", "structure_raw_format", "source_artifact_id", "source_locator", "evidence_id", "structure_evidence_status", "normalized_smiles", "canonical_smiles", "inchikey", "normalization_rule_version", "parse_sanitize_status", "error_class", "curation_disposition", "review_status", "murcko_status", "murcko_reason", "ecfp4_status", "ecfp4_reason", "ecfp6_status", "ecfp6_reason", "drfp_status", "drfp_reason", "reaction_center_fp_status", "reaction_center_fp_reason"]},
    "condition_registry": {"primary_key": ["component_id"], "required": ["component_id", "registry_version", "entity_scope", "source_dataset", "role", "raw_value", "normalized_name", "component_value_state", "structure_raw_value", "normalized_smiles", "canonical_smiles", "inchikey", "structure_status", "structure_error_class", "evidence_id", "source_artifact_id", "source_locator", "review_status"]},
    "condition_mappings": {"primary_key": ["mapping_id"], "required_for_non_identity": ["mapping_id", "mapping_version", "source_component_id", "source_scope", "target_representation", "target_scope", "mapping_kind", "non_identity", "source_raw_value", "normalized_value", "rule_id", "rule_version", "evidence_id", "source_artifact_id", "source_locator", "review_status", "reviewer_id", "review_disposition"]},
    "condition_attributes": {"primary_key": ["attribute_id"], "required": ["attribute_id", "component_id", "attribute_name", "attribute_value", "attribute_provenance", "evidence_id", "source_artifact_id", "source_locator", "review_status"]},
    "condition_compositions": {"primary_key": ["composition_id"], "required": ["composition_id", "reaction_id", "role", "raw_label", "component_component_id", "component_scope", "ratio_raw_value", "ratio_raw_unit", "ratio_normalized_value", "ratio_normalized_unit", "composition_rule_id", "composition_rule_version", "evidence_id", "source_artifact_id", "source_locator", "review_status"], "perera_documented_mixture": {"role": "solvent", "components": ["organic_carrier", "H2O"], "ratio_raw_value": "9:1", "ratio_raw_unit": "volume_ratio"}},
    "continuous_observations": {"primary_key": ["continuous_observation_id"], "required": ["continuous_observation_id", "reaction_id", "field_name", "raw_value", "raw_unit", "normalized_value", "normalized_unit", "conversion_rule_id", "conversion_rule_version", "evidence_id", "source_artifact_id", "source_locator", "value_state", "review_status"], "value_state_domain": "continuous_value_state"}
  },
  "mapping_rules": {"non_identity_requires_accepted_review": true, "target_scope_required": true, "cross_source_mapping_requires_non_identity": true, "derived_attribute_must_not_be_presented_as_evidence": true, "record_component_reference_rule": "every reference resolves to exactly one registry entity with identical source_dataset and role"},
  "condition_coverage_gate": {"discrete_roles": {"ahneman_doyle_buchwald_hartwig_2018": ["catalyst_system", "ligand", "base", "additive"], "perera_suzuki_miyaura_2018": ["catalyst", "ligand", "base", "solvent_1", "solvent_2", "atmosphere"]}, "state_coverage_required": 1.0, "valid_or_explicit_null_completeness_min": 0.99, "not_reported_is_valid_only_when_source_does_not_report_role": true},
